# ─── Meta / Instagram ───────────────────────────────────────
# Token generado en el Explorador de la API Graph de Meta
# Con permisos: instagram_basic, instagram_content_publish, pages_read_engagement
META_ACCESS_TOKEN=your_token_here

# ID de tu cuenta de Instagram Business
# Obtenido con: GET /{page-id}?fields=instagram_business_account
INSTAGRAM_BUSINESS_ID=your_instagram_business_id_here

# ─── ImgBB (hosting de imágenes) ────────────────────────────
# API Key gratuita en: https://api.imgbb.com/
IMGBB_API_KEY=your_imgbb_api_key_here
